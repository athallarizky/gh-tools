{
  "name": "gh-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A collection of TypeScript CLI tools for GitHub.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "dev": "node api.js && tsx"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
