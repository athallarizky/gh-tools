{
  "name": "portfolio-history",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scan locally cloned Git repositories and build a CV-ready portfolio summary from git history.",
  "bin": {
    "portfolio-history": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node api.js && tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.6.0",
    "zod": "^3.25.0"
  },
  "engines": {
    "node": ">=20"
  }
}
